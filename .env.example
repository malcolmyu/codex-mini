# Optional. The bridge normally reuses the existing Codex/ChatGPT login.
# OPENAI_API_KEY=

# Restrict real Weixin messages to this iLink user id after login.
# WEIXIN_OWNER_USER_ID=

# Workspace used when no --cwd is supplied.
# CODEX_WECHAT_CWD=/absolute/path/to/project

# Override only when testing another Codex binary through codex-acp.
# CODEX_PATH=/absolute/path/to/codex
